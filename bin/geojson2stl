#!/usr/bin/env node

const fs = require('fs');
const path = require('path');
const commander = require('commander');
const geojson2stl = require('../');
const bbox = require('@turf/bbox').default;
const colors = require('colors');

commander
    .version(require('../package.json').version)
    .usage('[options] <input.geojson>')
    .description('🛠️ Convert a GeoJSON file into a 3D STL file for printing or visualization.')
    .option('-o, --output <path>', 'Output file name (default: ./output.stl)', './output.stl')
    .option('-e, --extrude <int>', 'Extrude height in mm (default: 1)', parseInt, 1)
    .option('-s, --size <int>', 'Output model size in mm (default: 200)', parseInt, 200)
    .parse(process.argv);

const inputFile = commander.args[0];

if (!inputFile) {
    console.error('\n❌ Error: No input file provided.\n'.red);
    commander.help(); // Muestra ayuda y termina
}

try {
    const data = fs.readFileSync(inputFile, 'utf-8');
    const geojson = JSON.parse(data);

    const stl = geojson2stl(geojson, {
        size: commander.size,
        extrude: commander.extrude,
        output: commander.output
    });

    fs.writeFileSync(commander.output, stl);
    console.log(`\n✅ STL file generated successfully: ${commander.output.green}\n`);
} catch (err) {
    console.error(`\n❌ An error occurred: ${err.message}\n`.red);
    process.exit(1);
}
